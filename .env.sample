# ==============================
# 🌐 CONFIGURATION EXCHANGE
# ==============================
EXCHANGE_USERNAME=GROUPE\\user
EXCHANGE_EMAIL=email
EXCHANGE_PASSWORD=tonMotDePasseExchangeIci

# ==============================
# 📅 GOOGLE CALENDAR
# ==============================
GOOGLE_CALENDAR_ID=xxx@group.calendar.google.com

# ==============================
# ⚙️ AUTRES PARAMÈTRES
# ==============================
TIMEZONE=Europe/Paris
DAYS_AHEAD=60
ENABLE_NOTIFICATIONS=true
HEALTHCHECK_URL=https://hc-ping.com/votre-uuid-healthchecks
# Vérification TLS des pings healthchecks.io. Laisser à true.
VERIFY_SSL=true
# Bundle de CA à utiliser si le réseau passe par un proxy TLS d'entreprise
# (requests utilise certifi par défaut, qui ignore les CA système).
# CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
